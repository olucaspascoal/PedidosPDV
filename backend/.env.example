# Variáveis de ambiente da API em produção (configure no painel da hospedagem, nunca commite valores reais)

# Supabase → Project Settings → Database → Connection string → "Session pooler" (URI ou formato Host=...)
ConnectionStrings__Default=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Chave aleatória com 32+ caracteres (ex.: openssl rand -base64 48)
Jwt__Key=

# Domínio(s) do frontend na Hostinger, separados por vírgula
Cors__Origins=https://seudominio.com.br,https://www.seudominio.com.br

# PIN do primeiro administrador (usado só quando o banco está vazio)
Seed__AdminPin=

# Mercado Pago
MercadoPago__AccessToken=
MercadoPago__NotificationUrl=https://api.seudominio.com.br/api/webhooks/mercadopago
MercadoPago__WebhookSecret=
