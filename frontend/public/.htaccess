# Hostinger / Apache: entrega o app Angular em qualquer rota (/pdv, /gestao/vendas...)
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Força HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Arquivos e pastas existentes são servidos normalmente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todo o resto vai para o index.html
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # index.html e config.js nunca ficam em cache (para pegar novas versões e a URL da API)
  <FilesMatch "^(index\.html|config\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  # Arquivos com hash no nome podem ficar em cache por 1 ano
  <FilesMatch "\.[0-9a-zA-Z]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
